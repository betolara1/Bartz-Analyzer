            <TooltipContent className="text-xs">Selecionar pasta no explorador</TooltipContent>
          </Tooltip>
        </div>

        {/* Test Result Indicator */}
        {test && (
          <div className="mt-2 text-[11px] flex items-center gap-1.5 font-medium">
